# ---- Core --------------------------------------------------------------
NODE_ENV=production
PORT=3333
DATABASE_URL=postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/compai?sslmode=require
# Azure Postgres chains to DigiCert Global Root G2 / Microsoft RSA Root 2017.
# The image default points at the AWS RDS bundle. Mount the Azure bundle and point here.
# NODE_EXTRA_CA_CERTS=/certs/azure-postgres-ca.pem
SECRET_KEY=            # openssl rand -base64 32
ENCRYPTION_KEY=        # openssl rand -base64 32. Never rotate without re-encrypting credentials.
INTERNAL_API_TOKEN=    # openssl rand -hex 32

# ---- Domains (see SELF_HOSTING.md "Custom Domain") ---------------------
BASE_URL=https://api.compliance.masri.tech
BETTER_AUTH_URL=https://api.compliance.masri.tech
NEXT_PUBLIC_APP_URL=https://compliance.masri.tech
NEXT_PUBLIC_PORTAL_URL=https://employee.compliance.masri.tech
NEXT_PUBLIC_API_URL=https://api.compliance.masri.tech
AUTH_COOKIE_DOMAIN=.compliance.masri.tech
AUTH_TRUSTED_ORIGINS=https://compliance.masri.tech,https://employee.compliance.masri.tech
AUTH_TRUSTED_ORIGIN_SUFFIXES=.compliance.masri.tech

# ---- Sign-in (Microsoft Entra, Masri multi-tenant app) -----------------
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
AUTH_MICROSOFT_TENANT_ID=common

# ---- Service tokens ------------------------------------------------------
SERVICE_TOKEN_TRIGGER=  # openssl rand -hex 32
SERVICE_TOKEN_PORTAL=   # openssl rand -hex 32

# ---- Redis (srh container, Upstash-compatible REST) ----------------------
UPSTASH_REDIS_REST_URL=http://srh:80
UPSTASH_REDIS_REST_TOKEN=   # same value as deploy/masri/.env

# ---- Object storage: Cloudflare R2 (S3-compatible) -----------------------
APP_AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
APP_AWS_REGION=auto
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=
APP_AWS_BUCKET_NAME=compai-attachments
APP_AWS_ORG_ASSETS_BUCKET=compai-org-assets
APP_AWS_QUESTIONNAIRE_UPLOAD_BUCKET=compai-questionnaires
APP_AWS_KNOWLEDGE_BASE_BUCKET=compai-knowledge-base

# ---- Email: Cloudflare Email Service -------------------------------------
EMAIL_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=   # token with only Email Sending: Edit
EMAIL_FROM_SYSTEM=Masri Compliance <no-reply@compliance.masri.tech>
EMAIL_FROM_DEFAULT=Masri Compliance <notifications@compliance.masri.tech>
EMAIL_FROM_TRUST_PORTAL=Masri Compliance <no-reply@compliance.masri.tech>
EMAIL_REPLY_TO=<support mailbox that feeds HaloPSA>

# ---- Background jobs: Trigger.dev ----------------------------------------
TRIGGER_SECRET_KEY=
# TRIGGER_API_URL=https://trigger.<your-host>   # self-hosted Trigger.dev only
# TRIGGER_PROJECT_ID=proj_...                   # self-hosted Trigger.dev only

# ---- HaloPSA (hosted, Azure) ----------------------------------------------
HALOPSA_BASE_URL=https://portal.masri.tech
HALOPSA_AUTH_URL=          # copy from Halo > Configuration > Integrations > Halo API > API Details
HALOPSA_TENANT=            # copy from API Details
HALOPSA_CLIENT_ID=
HALOPSA_CLIENT_SECRET=
HALOPSA_SCOPE=read:customers edit:customers read:tickets edit:tickets read:assets read:teams read:agents
HALOPSA_WEBHOOK_SECRET=    # openssl rand -hex 32; set as Bearer token on the Halo webhook
HALOPSA_OUTBOX_PAUSED=false

# ---- AI features (optional) ----------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
