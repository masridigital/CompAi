NODE_ENV=production
DATABASE_URL=postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/compai?sslmode=require
AUTH_SECRET=            # openssl rand -base64 32
SECRET_KEY=             # same value as the API
BETTER_AUTH_URL=https://api.compliance.masri.tech
NEXT_PUBLIC_BETTER_AUTH_URL=https://api.compliance.masri.tech
NEXT_PUBLIC_API_URL=https://api.compliance.masri.tech
NEXT_PUBLIC_APP_URL=https://compliance.masri.tech
NEXT_PUBLIC_PORTAL_URL=https://employee.compliance.masri.tech
NEXT_PUBLIC_SELF_HOSTED=true
REVALIDATION_SECRET=    # openssl rand -hex 32
SERVICE_TOKEN_TRIGGER=  # same value as the API
INTERNAL_API_TOKEN=     # same value as the API
UPSTASH_REDIS_REST_URL=http://srh:80
UPSTASH_REDIS_REST_TOKEN=
TRIGGER_SECRET_KEY=
# TRIGGER_APP_PROJECT_ID=proj_...   # self-hosted Trigger.dev only
APP_AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
APP_AWS_REGION=auto
APP_AWS_ACCESS_KEY_ID=
